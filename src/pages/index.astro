---
import MainLayout from '../layouts/MainLayout.astro';
import PromptCard from '../components/ui/PromptCard.astro';
import FilterBar from '../components/interactive/FilterBar.astro';
import { getCollection } from 'astro:content';

const allPrompts = await getCollection('prompts');
const uniqueRoles = [...new Set(allPrompts.map(p => p.data.role))];
const uniqueCategories = [...new Set(allPrompts.map(p => p.data.category))];
---

<MainLayout title="Static AI Hub - Library">
  <section class="text-center mb-10 pt-4">
    <h1 class="text-4xl md:text-5xl font-extrabold mb-4 bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600 dark:from-blue-400 dark:to-purple-400">
      Prompt Library
    </h1>
    <p class="text-gray-600 dark:text-gray-400">Official Prompts + Personal Drafts.</p>
  </section>

  <section class="sticky top-16 z-40 py-4 mb-6 bg-gray-50/95 dark:bg-gray-900/95 backdrop-blur-sm border-b border-gray-200/50 dark:border-gray-800/50 transition-colors -mx-4 px-4 md:mx-0 md:px-0 md:bg-transparent md:backdrop-blur-none md:border-none">
    <div class="max-w-6xl mx-auto">
      <FilterBar roles={uniqueRoles} categories={uniqueCategories} />
    </div>
  </section>

  <div id="prompt-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pb-20">
    {allPrompts.map((prompt) => (
      <PromptCard 
        id={prompt.slug}
        title={prompt.data.title}
        description={prompt.data.description}
        role={prompt.data.role}
        category={prompt.data.category}
        tags={prompt.data.tags}
        body={prompt.body}
      />
    ))}
    
    </div>

  <div id="no-results" class="hidden text-center py-20">
    <p class="text-xl text-gray-500">Tidak ada prompt yang cocok 😔</p>
  </div>
</MainLayout>

<script>
  import { addToast } from '../lib/toastStore';

  const grid = document.getElementById('prompt-grid');
  
  function loadPersonalPrompts() {
    const saved = localStorage.getItem('my_prompts');
    if (!saved || !grid) return;

    try {
      const prompts = JSON.parse(saved);
      
      // Looping data storage dan inject HTML Card
      prompts.forEach((p: any) => {
        // Encode text body agar aman saat dimasukkan ke dalam atribut HTML
        const safeBody = encodeURIComponent(p.body);

        const cardHTML = `
          <article class="prompt-card group relative flex flex-col justify-between p-6 bg-white dark:bg-gray-800 rounded-xl border-2 border-dashed border-blue-200 dark:border-blue-900 shadow-sm" data-role="Personal" data-category="Draft">
            <div>
              <div class="flex justify-between items-start mb-4">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-600 dark:bg-purple-900/30 dark:text-purple-300">
                  PERSONAL
                </span>
                <span class="text-xs text-gray-400 font-medium uppercase tracking-wider">DRAFT</span>
              </div>
              <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
                ${p.data.title}
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-6 leading-relaxed">
                ${p.data.description}
              </p>
            </div>
            <div class="mb-4">
              <div class="relative bg-gray-50 dark:bg-gray-900 rounded-lg border border-gray-100 dark:border-gray-800 p-4 font-mono text-sm text-gray-700 dark:text-gray-300 overflow-hidden">
                 <div class="absolute bottom-0 left-0 right-0 h-8 bg-gradient-to-t from-gray-50 dark:from-gray-900 to-transparent pointer-events-none"></div>
                 <p class="line-clamp-3 whitespace-pre-wrap">${p.body}</p>
              </div>
            </div>
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-100 dark:border-gray-700">
              <span class="text-xs text-gray-400">Disimpan di Browser</span>
              <button onclick="
                const text = decodeURIComponent('${safeBody}');
                navigator.clipboard.writeText(text).then(() => {
                   window.dispatchEvent(new CustomEvent('toast-copy'));
                });
              " class="text-xs font-bold bg-blue-50 text-blue-600 hover:bg-blue-100 px-3 py-1.5 rounded-lg dark:bg-blue-900/30 dark:text-blue-300 transition-colors cursor-pointer ml-auto">
                Copy
              </button>
            </div>
          </article>
        `;
        // Masukkan ke grid paling depan
        grid.insertAdjacentHTML('afterbegin', cardHTML);
      });
    } catch (e) {
      console.error("Gagal memuat draft:", e);
    }
  }

  // Listener untuk menangkap event copy dari tombol personal
  window.addEventListener('toast-copy', () => {
    addToast('Draft Personal berhasil disalin!', 'success');
  });

  // Jalankan saat halaman siap
  document.addEventListener('DOMContentLoaded', loadPersonalPrompts);
</script>