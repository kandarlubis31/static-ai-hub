---
import MainLayout from '../layouts/MainLayout.astro';
import { Home } from 'lucide-preact';
---

<MainLayout title="404 - Halaman Tidak Ditemukan">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <div class="mb-6 relative">
      <div class="absolute inset-0 bg-blue-500 blur-3xl opacity-20 dark:opacity-40 rounded-full"></div>
      
      <h1 class="relative text-9xl font-extrabold text-gray-900 dark:text-white tracking-tighter">
        404
      </h1>
    </div>

    <h2 class="text-2xl md:text-3xl font-bold text-gray-800 dark:text-gray-100 mb-3">
      Prompt Hilang di Antah Berantah
    </h2>
    
    <p class="text-gray-600 dark:text-gray-400 max-w-md mb-8">
      Sepertinya halaman yang kamu cari sudah dihapus atau tidak pernah ada. Jangan panik, kembali ke library aja.
    </p>

    <a 
      href="/" 
      class="flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-full font-medium transition-all hover:scale-105 active:scale-95 shadow-lg shadow-blue-500/30"
    >
      <Home size={20} />
      Kembali ke Library
    </a>
  </div>
</MainLayout>